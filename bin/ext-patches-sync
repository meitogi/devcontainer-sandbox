#!/usr/bin/env bash
# ext-patches-sync — apply patchers to the baked VS Code extension.
#
# Usage:  ext-patches-sync            resolve, fetch if needed, apply
#         ext-patches-sync --status   say what is configured and cached, do nothing
#         ext-patches-sync --force    apply even if the sentinels are already live
#
# This image installs its VS Code extension exactly as published and patches
# nothing. Some operators keep their own patchers — for their own copy, on
# their own machine, by their own choice. This is the seam for that, and it is
# deliberately generic: it knows about "a directory of patchers" and "a
# repository holding one", never about any particular extension or vendor.
#
# Called by the 45-ext-patches.sh hook fragments in on-create and post-start,
# and safe to run by hand. It must never fail a boot: every path ends in
# exit 0, a missing variable is announced rather than fatal, and a stale cache
# is preferred to no patchers at all.
#
# Resolution order:
#   1. patchers already applied (sentinels present)  -> nothing to do
#   2. EXT_PATCHES_DIR                               -> no network, no token
#   3. a tarball, only if a token is present         -> cached under <ref>/
#      — EXT_PATCHES_REF pins it; unset (or `auto`) it is this extension's
#      own line, cc<version>-r<n> with the largest n, the cache first
#   4. this project's own patchers, under            -> merged over 2/3, and
#      $DEVC_CONFIG_DIR/claude/vscode-ext-patchs        a source on their own
#   5. none of the above                             -> silence
#
# 4 is not a fallback: local patchers are merged over whatever 2 or 3
# resolved, shadowing same-named files (build_work). They also make a
# container configured all by themselves, with no variable set and no
# network — which is the nominal shape of a project that brings its own.
# Listing only four states here is what let --status answer "nothing
# configured" to a container that had just applied twelve of them.

set -uo pipefail

# --status was documented from the first version and never parsed, so it fell
# through to the apply path: a flag whose whole promise is "do nothing" was
# rewriting the extension. Parsed here, and an unknown flag is refused rather
# than ignored, for the same reason run-all.sh refuses an unknown selection.
MODE=apply
FORCE="${EXT_PATCHES_FORCE:-}"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --status) MODE=status ;;
    --force)  FORCE=1 ;;
    -h|--help) sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'ext-patches-sync: unknown option %s\n' "$1" >&2; exit 64 ;;
  esac
  shift
done

CONF_DIR="${DEVC_CONFIG_DIR:-/workspace/.devcontainer}"
ENV_FILE="$CONF_DIR/.env"
CACHE_ROOT="$CONF_DIR/tmp/cache/ext-patchs"
LOCAL_PATCHERS="$CONF_DIR/claude/vscode-ext-patchs"
TOOLKIT_DIR="${TOOLKIT_DIR:-/usr/local/bin/vscode-ext-patchs}"
BUILD_ENV="${BUILD_ENV:-/etc/claude-build-env}"
# Overridable for the same reason as the four above: it is the last hardcoded
# path in this script, and it was what kept the hook's behaviour untestable —
# every suite could say the binary exists, none could say what it does.
RESTORE="${RESTORE_EXT_PATCHES:-/usr/local/bin/restore-ext-patches}"

YELLOW='\033[1;33m'; RESET='\033[0m'

# One fact per line, the repair under a `↳`. This drew its own 64-column box
# until the boot budget was measured: 3 lines of rule and title for every
# warning, 14 for the pin mismatch alone — and on a first boot the whole thing
# twice, once per phase. The frame is bin/boot-summary's privilege now, which
# is what manifest.test.sh freezes for assets/opt/hooks/; the two fragments the
# old comment here pointed at (22-firewall-bake-warn.sh, 42-claude-ext-pin-warn.sh)
# stopped drawing one before this file did.
#
# The signature is unchanged — one string per line, the first being the fact and
# the rest its consequence and its repair — so the 17 call sites did not move.
# Two behaviours go with the box: an empty string was a blank row and now means
# nothing, so it is skipped rather than printed as a bare `↳`; and the 58-column
# truncation is gone, because outside a box it only ever destroyed the end of a
# sentence (`… an apply would ch…`, measured on the boot of 2026-09-25).
banner() {
  local s first=1
  printf "%b" "$YELLOW"
  while [ "$#" -gt 0 ]; do
    s="$1"; shift
    [ -z "$s" ] && continue
    if [ "$first" = 1 ]; then
      printf '⚠ ext-patches: %s\n' "$s"; first=0
    else
      printf '  ↳ %s\n' "$s"
    fi
  done
  printf "%b" "$RESET"
}

# Value of a variable: the environment wins (compose injects .env at create),
# otherwise read .env directly so editing it and restarting is enough — no
# recreate required. Anchored grep, last assignment wins, quotes stripped.
conf() {
  local name="$1" v="${!1:-}"
  if [ -z "$v" ] && [ -r "$ENV_FILE" ]; then
    v=$(sed -n "s/^[[:space:]]*${name}=//p" "$ENV_FILE" | tail -1)
    v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
  fi
  printf '%s' "$v"
}

EXT_PATCHES_DIR="$(conf EXT_PATCHES_DIR)"
EXT_PATCHES_REPO="$(conf EXT_PATCHES_REPO)"
EXT_PATCHES_REF="$(conf EXT_PATCHES_REF)"
EXT_PATCHES_TOKEN="$(conf EXT_PATCHES_TOKEN)"
# `<change-me>` is the placeholder .env.example ships so the line exists to be
# filled — by hand, or by `devc initialize` from ~/.config/devc/ext-patches.env.
# It is not a token: a fetch with it would only earn a 401 banner. Treated as
# unset, and said in one line rather than a banner: a project that never set
# it is the unconfigured case, which boots in silence.
TOKEN_PLACEHOLDER=0
case "$(printf '%s' "$EXT_PATCHES_TOKEN" | tr '[:upper:]' '[:lower:]')" in
  '<change-me>'|change-me) TOKEN_PLACEHOLDER=1; EXT_PATCHES_TOKEN="" ;;
esac
SELECT="$(conf EXT_PATCHES_SELECT)"; SELECT="${SELECT:-all}"

# Nominal state of the published image: nothing configured, nothing to say.
# --status is the exception: "nothing is configured" is precisely the answer it
# was asked for, so it gets reported instead of exited on.
CONFIGURED=1
# A project that only brings its own patchers is configured too: this image's
# whole contract is a base plus an override, the way skills and hooks already
# work, and a directory of .py the operator put there IS the intent.
[ -z "$EXT_PATCHES_DIR" ] && [ -z "$EXT_PATCHES_TOKEN" ] \
  && ! compgen -G "$LOCAL_PATCHERS/*.py" >/dev/null 2>&1 && CONFIGURED=0
if [ "$CONFIGURED" = 0 ] && [ "$MODE" != status ]; then
  [ "$TOKEN_PLACEHOLDER" = 1 ] && echo "- ext-patches: EXT_PATCHES_TOKEN is the <change-me> placeholder — set it in .env or in ~/.config/devc/ext-patches.env; the extension stays as published"
  exit 0
fi

EXT_DIR=""
# shellcheck disable=SC1090
[ -r "$BUILD_ENV" ] && . "$BUILD_ENV"
if [ -z "${EXT_DIR:-}" ] || [ ! -d "${EXT_DIR:-}" ]; then
  EXT_DIR=""
  if [ "$MODE" != status ]; then
    if [ -r "$BUILD_ENV" ]; then
      banner "no extension on disk — the VSIX bake failed for this image." \
             "Patchers not applied."
    else
      banner "no $BUILD_ENV — this image bakes no extension." \
             "Patchers not applied."
    fi
    exit 0
  fi
fi

# --- 0. is the token about to expire? ----------------------------------------
# Captured from the last successful fetch. GitHub omits the header entirely for
# a token created with "No expiration", in which case the file is absent and
# this stays silent — absence is a valid answer here, not a parse failure.
warn_if_expiring() {
  local f="$1/.token-expiration" exp days
  [ -r "$f" ] || return 0
  exp=$(tr -d '\r' < "$f")
  [ -n "$exp" ] || return 0
  # GitHub sends a full timestamp; the day is the only part worth showing, and
  # the whole thing would overflow the banner box.
  exp="${exp%%T*}"; exp="${exp%% *}"
  days=$(python3 - "$exp" <<'PYEXP' 2>/dev/null
import sys, datetime, re
m = re.match(r"(\d{4}-\d{2}-\d{2})", sys.argv[1].strip())
if not m: raise SystemExit(1)
d = datetime.date.fromisoformat(m.group(1)) - datetime.date.today()
print(d.days)
PYEXP
) || return 0
  [ -n "$days" ] || return 0
  if [ "$days" -le 14 ]; then
    if [ "$days" -lt 0 ]; then
      banner "EXT_PATCHES_TOKEN expired on $exp." \
             "Renew it at github.com/settings/personal-access-tokens"
    else
      banner "EXT_PATCHES_TOKEN expires in $days day(s) — $exp." \
             "Renew it at github.com/settings/personal-access-tokens"
    fi
  fi
}

# --- 1. already applied? -----------------------------------------------------
# AND over a patcher's declared sentinels, OR over its declared files — the
# same rule restore-ext-patches --list uses. Answered from whichever patcher
# directory is already on disk, so the nominal post-start costs no network.
# A patcher may declare @patch-min/max-version, and run-all.sh honours them:
# out of range it does not run AT ALL, so its sentinel is never written.
# Asking for that sentinel here would answer "not applied" for ever, and every
# restart would re-apply a set that is already correct — the nominal post-start
# is supposed to cost milliseconds and no network. So the same predicate is
# asked first, and it has to be the same predicate: integer tuples, inclusive
# bounds, never a string comparison ("2.1.9" sorts above "2.1.258").
ver_key() {
  local IFS=.
  set -- $1
  printf '%05d.%05d.%05d' "$((10#${1:-0}))" "$((10#${2:-0}))" "$((10#${3:-0}))"
}

# X.Y.Z as written, for the messages and for versions.json; ext_key pads it for
# the comparisons. Two accessors over one parse because a padded key reads
# "00002.00001.00258" and no human wants that in a warning.
EXT_VER=""
ext_ver() {
  [ -n "$EXT_VER" ] && { printf '%s' "$EXT_VER"; return 0; }
  [ -n "${EXT_DIR:-}" ] && [ -f "$EXT_DIR/package.json" ] || return 1
  EXT_VER="$(python3 -c 'import json,re,sys
v=json.load(open(sys.argv[1])).get("version","")
p=re.findall(r"\d+",v)[:3]
print(".".join(p+["0"]*(3-len(p))) if p else "")' "$EXT_DIR/package.json" 2>/dev/null)" || return 1
  [ -n "$EXT_VER" ] || return 1
  printf '%s' "$EXT_VER"
}

EXT_KEY=""
ext_key() {
  [ -n "$EXT_KEY" ] && { printf '%s' "$EXT_KEY"; return 0; }
  local raw
  raw="$(ext_ver)" || return 1
  EXT_KEY="$(ver_key "$raw")"
  printf '%s' "$EXT_KEY"
}

# --- 0a-bis. does the ref's own name target this extension? ------------------
# The tag schema is `cc<version>-r<n>`, so a ref DECLARES the extension version
# it was cut for. Nothing used to read that: EXT_PATCHES_REF was a cache key, a
# status line and a fetch URL, never a claim about a target. A pin left behind
# by a CC bump was therefore applied verbatim to a bundle it was never written
# for — measured 2026-09-16, cc2.1.258-r2 against extension 2.1.272: eight
# patchers failed loudly and NINE applied. The nine are the reason this exists.
# A failed patcher is visible; one whose anchor still matches in code that moved
# four CC lines is not, and `node --check` only proves the result parses.
#
# Empty when the ref is not in that shape — a SHA, a branch, `main`. Nothing is
# declared there, so nothing is claimed, and this says nothing.
ref_target_ver() {
  local r="${EXT_PATCHES_REF:-}" v
  case "$r" in
    cc[0-9]*) ;;
    *) return 1 ;;
  esac
  v="${r#cc}"; v="${v%%-*}"
  case "$v" in
    *[!0-9.]*|"") return 1 ;;
  esac
  printf '%s' "$v"
}

# Said at the END of the run, not at the start : the note below is emitted
# during resolution and that is where it got buried — under the per-patcher
# output and a summary of eight red lines. This one is the last thing printed,
# which is the only placement a warning about a silent mismatch can have.
warn_ref_version_mismatch() {
  local want have
  want="$(ref_target_ver)" || return 0
  have="$(ext_ver)" || return 0
  [ "$(ver_key "$want")" = "$(ver_key "$have")" ] && return 0
  # One sentence per line now that no box dictates the width. The two version
  # numbers are the entire content of this warning, so they lead.
  banner "pin $EXT_PATCHES_REF targets extension $want." \
         "This container runs extension $have." \
         "Patchers were applied anyway: the ones that FAILED are the visible half, and the ones that applied matched $want anchors in $have code, which nothing verifies." \
         "Move the pin with ext-patches-update, then reload the VS Code window." \
         "Or pin by hand: EXT_PATCHES_REF=cc$have-r<n>"
}

# --- 0b. was this ref ever tested on this extension? -------------------------
# A patcher repository's versions.json says which Claude Code versions its
# patchers were validated against. Until now that knowledge stopped at its own
# test suite: no container-side code read it, so a ref pinned by hand — or a
# .env copied from another project — could carry a set that has never seen this
# extension, silently. This says so.
#
# It is a NOTE, never a gate. What a patcher runs on is decided by
# @patch-min/max-version and nothing else; ext-patches-update's tag resolution
# covers the nominal path, and this covers the one it cannot see.
#
# Said once. It is asked from two places — the cache hit, which is also the
# restart short-circuit, and the fetch — because neither alone covers both a
# cold create and every boot after it.
VERSIONS_SAID=0
warn_untested_version() {
  local f="$1/versions.json" ver listed
  [ "$VERSIONS_SAID" = 0 ] || return 0
  [ -r "$f" ] || return 0
  ver="$(ext_ver)" || return 0
  # "yes" can never collide with a version string, so one call answers both
  # "is it listed?" and "what is listed?" — and a malformed file returns
  # neither, which the || return 0 reads as "nothing to say".
  listed="$(python3 -c 'import json,sys
vs=json.load(open(sys.argv[1])).get("versions") or []
print("yes" if sys.argv[2] in vs else " ".join(vs))' "$f" "$ver" 2>/dev/null)" || return 0
  [ -z "$listed" ] && return 0
  [ "$listed" = yes ] && return 0
  VERSIONS_SAID=1
  printf "%b⚠ ext-patches: %s@%s was never tested on extension %s (tested: %s).%b\n" \
    "$YELLOW" "${EXT_PATCHES_REPO:-?}" "${EXT_PATCHES_REF:-?}" "$ver" "$listed" "$RESET" >&2
}

# Unreadable extension version -> treat every patcher as in range. That is the
# behaviour from before bounds existed, and run-all.sh degrades the same way:
# a gate nobody can evaluate must not start hiding patchers.
in_range() {
  local lo hi key
  lo="$(sed -n 's/^# @patch-min-version: //p' "$1" | head -1)"
  hi="$(sed -n 's/^# @patch-max-version: //p' "$1" | head -1)"
  [ -n "$lo$hi" ] || return 0
  key="$(ext_key)" || return 0
  [ -n "$lo" ] && [ "$key" \< "$(ver_key "$lo")" ] && return 1
  [ -n "$hi" ] && [ "$key" \> "$(ver_key "$hi")" ] && return 1
  return 0
}

all_live() {
  local dir="$1" py base found s f
  [ -n "$EXT_DIR" ] || return 1
  shopt -s nullglob
  local pys=("$dir"/*.py)
  [ "${#pys[@]}" -gt 0 ] || return 1
  local seen=0
  for py in "${pys[@]}"; do
    base="${py##*/}"; [ "$base" = "_common.py" ] && continue
    in_range "$py" || continue
    seen=1
    while IFS= read -r s || [ -n "$s" ]; do
      [ -z "$s" ] && continue
      found=no
      while IFS= read -r f || [ -n "$f" ]; do
        [ -f "$EXT_DIR/$f" ] || continue
        grep -qF -- "$s" "$EXT_DIR/$f" && { found=yes; break; }
      done < <(sed -n 's/^# @patch-files: //p' "$py")
      [ "$found" = no ] && return 1
    done < <(sed -n 's/^# @patch-sentinel: //p' "$py")
  done
  [ "$seen" = 1 ]
}

# --- 1b. the project's own patchers, and how we notice they changed ---------
# The override half of the contract. run-all.sh scans ONE directory, so the
# resolved patchers and the project's own have to meet in a single work dir;
# the project's are copied LAST, so a file of the same name wins. Same
# base-plus-override shape as skills and hooks, and the same rule: last layer
# wins, and it must be said out loud.
#
# A stable path, not a mktemp: once assembled, this IS the patch set of this
# container, and restore-ext-patches falls back to it. Without that, `--list`
# would answer "no patcher" right after the hook applied sixteen of them.
WORK="$CACHE_ROOT/.work"
STAMP="$CACHE_ROOT/.local-stamp"

has_local() { compgen -G "$LOCAL_PATCHERS/*.py" >/dev/null 2>&1; }

# Names, sizes and mtimes of the override directory. The sentinel check cannot
# see an edit that keeps the same marker — and editing a patcher in place,
# restarting, and looking is exactly the loop this directory exists for. So
# the stamp answers the other question: did the operator touch anything here?
local_stamp() {
  has_local || { printf 'none\n'; return 0; }
  ( cd "$LOCAL_PATCHERS" && for f in *.py; do
      printf '%s %s %s\n' "$f" "$(stat -c '%s %Y' "$f" 2>/dev/null \
        || stat -f '%z %m' "$f" 2>/dev/null)"
    done ) | sort
}

build_work() {
  rm -rf "$WORK"; mkdir -p "$WORK"
  [ -n "$SRC" ] && cp -a "$SRC"/*.py "$WORK/" 2>/dev/null
  if has_local; then
    # Announce the overrides by name. A local file silently shadowing a
    # tagged one is how you end up debugging the wrong source.
    local over=""
    for f in "$LOCAL_PATCHERS"/*.py; do
      b="${f##*/}"; [ "$b" = "_common.py" ] && continue
      [ -n "$SRC" ] && [ -f "$SRC/$b" ] && over="$over $b"
    done
    cp -a "$LOCAL_PATCHERS"/*.py "$WORK/" 2>/dev/null || true
    echo "  … merged this project's own patchers from $LOCAL_PATCHERS"
    [ -n "$over" ] && echo "  … overriding:$over"
  fi
  rm -f "$WORK/_common.py"   # the toolkit's copy is the one under test
  return 0
}

# In strict mode every egress goes through mitmproxy, and the proxy variables
# that say so live in /etc/profile.d — which only a LOGIN shell sources. A
# lifecycle fragment is not one, so without this a fetch fails at the
# connection, before any HTTP status exists, and the container boots
# unpatched. Only filled in when the caller has not set them.
load_proxy() {
  if [ -z "${HTTPS_PROXY:-}${https_proxy:-}" ] && [ -r /etc/profile.d/devcontainer-proxy.sh ]; then
    # shellcheck disable=SC1091
    . /etc/profile.d/devcontainer-proxy.sh
    export HTTP_PROXY HTTPS_PROXY NO_PROXY 2>/dev/null || true
  fi
}

# The largest -r<n> of one version's line, from a /tags body. n is compared
# as an INTEGER, so r10 beats r9 (the trap run-all.sh:90-93 names one field
# over). By path, not down the pipe — `python3 -` takes its PROGRAM from
# stdin. Same rule as ext-patches-update's line_tag, duplicated for the reason
# given there: sync is an executable with side effects, not a library.
line_tag_of() {  # line_tag_of <tags-json-file> <version>
  python3 - "$1" "$2" <<'PYT'
import json, re, sys
try:
    names = [t.get("name", "") for t in json.load(open(sys.argv[1]))]
except Exception:
    raise SystemExit(1)
pat = re.compile(r"^cc" + re.escape(sys.argv[2]) + r"-r(\d+)$")
best = None
for n in names:
    m = pat.match(n)
    if m and (best is None or int(m.group(1)) > best[0]):
        best = (int(m.group(1)), n)
print(best[1] if best else "")
PYT
}

# --- 2b. no ref: this extension's own line -----------------------------------
# EXT_PATCHES_REF used to have no default at all — "pin a tag, there is no
# implicit HEAD" — and every CC bump of the image left a stale pin behind in
# every project, to be moved by hand with ext-patches-update. The tag schema
# already says which line a container should run (cc<version>-r<n>, the same
# rule ext-patches-update resolves), so an unset ref, or the word `auto`,
# resolves to it here, at boot:
#
#   1. the newest cc<version>-r<n> already CACHED — no network, and a boot
#      never moves on its own: a newer -r upstream is ext-patches-update's
#      deliberate act, exactly as with a pin;
#   2. else /tags, once, for the largest -r of this version — a fresh
#      container, or the first boot after a CC bump, which is the case that
#      used to go wrong;
#   3. no tag for this version → nothing applied, said out loud: pin a ref, or
#      take HEAD through ext-patches-update with EXT_PATCHES_ALLOW_UNTESTED=1.
#
# --status never reaches step 2: it is read-only and must not fetch.
# Prints the resolved tag; the notes go to stderr, so a command substitution
# gets only the name.
auto_ref() {
  local ver best="" n=-1 d name m tmpf tags
  ver="$(ext_ver)" || {
    banner "EXT_PATCHES_REF is unset (auto) but the extension version is unreadable — pin a ref." \
           "No patcher fetched." >&2
    return 1
  }
  for d in "$CACHE_ROOT"/cc"$ver"-r*/patchers; do
    [ -d "$d" ] && compgen -G "$d/*.py" >/dev/null 2>&1 || continue
    name="${d%/patchers}"; name="${name##*/}"; m="${name#cc$ver-r}"
    case "$m" in *[!0-9]*|"") continue ;; esac
    [ "$m" -gt "$n" ] && { n="$m"; best="$name"; }
  done
  if [ -n "$best" ]; then
    echo "→ ext-patches: ref auto → $best (cached line for extension $ver)" >&2
    printf '%s' "$best"; return 0
  fi
  [ "$MODE" = status ] && return 1
  command -v curl >/dev/null 2>&1 || { banner "curl is missing — cannot resolve a ref." >&2; return 1; }
  load_proxy
  # Captured from stdout, the way ext-patches-update's gh_get reads it.
  tags=$(curl -fsSL --max-time 30 --retry 3 --retry-delay 2 --retry-connrefused --retry-all-errors \
       -H "Authorization: Bearer $EXT_PATCHES_TOKEN" \
       -H "Accept: application/vnd.github+json" \
       -H "X-GitHub-Api-Version: 2022-11-28" \
       "https://api.github.com/repos/$EXT_PATCHES_REPO/tags?per_page=100" 2>/dev/null)
  tmpf=$(mktemp) || return 1
  if [ -n "$tags" ]; then
    printf '%s' "$tags" > "$tmpf"
    name=$(line_tag_of "$tmpf" "$ver")
    rm -f "$tmpf"
    if [ -n "$name" ]; then
      echo "→ ext-patches: ref auto → $name (newest tested line for extension $ver)" >&2
      printf '%s' "$name"; return 0
    fi
    banner "no tag cc$ver-r<n> in $EXT_PATCHES_REPO — the patchers were never tested on extension $ver." \
           "Pin EXT_PATCHES_REF, or take HEAD deliberately: EXT_PATCHES_ALLOW_UNTESTED=1 ext-patches-update" \
           "No patcher fetched." >&2
    return 1
  fi
  rm -f "$tmpf"
  banner "EXT_PATCHES_REF is unset (auto) and $EXT_PATCHES_REPO could not be reached for its tags." \
         "No patcher fetched — a pinned ref boots from its cache." >&2
  return 1
}

# --- 2/3. where do the patchers come from? ----------------------------------
SRC=""
if [ -n "$EXT_PATCHES_DIR" ]; then
  if [ -d "$EXT_PATCHES_DIR" ] && compgen -G "$EXT_PATCHES_DIR/*.py" >/dev/null; then
    SRC="$EXT_PATCHES_DIR"
  else
    banner "EXT_PATCHES_DIR=$EXT_PATCHES_DIR is not a directory holding .py patchers — ignoring it."
  fi
fi

CACHE=""
if [ -z "$SRC" ] && [ -n "$EXT_PATCHES_TOKEN" ]; then
  # A missing variable is named, never guessed and never fatal. In particular
  # there is no implicit HEAD: pinning is the whole point of a ref.
  if [ -z "$EXT_PATCHES_REPO" ]; then
    banner "EXT_PATCHES_TOKEN is set but EXT_PATCHES_REPO is not." \
           "No patcher fetched."; exit 0
  fi
  AUTO_REF=0
  case "$EXT_PATCHES_REF" in ""|auto) AUTO_REF=1 ;; esac
  if [ "$AUTO_REF" = 1 ]; then
    EXT_PATCHES_REF="$(auto_ref)" || { [ "$MODE" = status ] || exit 0; EXT_PATCHES_REF=""; }
  fi
  if [ -n "$EXT_PATCHES_REF" ]; then
    CACHE="$CACHE_ROOT/$EXT_PATCHES_REF"
    warn_if_expiring "$CACHE"
    # Before the short-circuit below, not after: a restart that finds every
    # sentinel live exits at :354 without reaching anything else, and this is
    # exactly the boot that needs to keep saying it.
    warn_untested_version "$CACHE"
    [ -d "$CACHE/patchers" ] && compgen -G "$CACHE/patchers/*.py" >/dev/null && SRC="$CACHE/patchers"
  fi
fi

# --- 3a. --status: say what holds, change nothing -----------------------------
# Everything above this point is resolution; the fetch below is the first thing
# that writes. So this is where a read-only report belongs, and why it is not a
# separate script: a second reader would drift from what the hook actually does.
if [ "$MODE" = status ]; then
  say() { printf '  %-18s %s\n' "$1" "$2"; }
  echo "ext-patches status"
  say "EXT_PATCHES_DIR"  "${EXT_PATCHES_DIR:-(unset)}"
  say "EXT_PATCHES_REPO" "${EXT_PATCHES_REPO:-(unset)}"
  if [ "${AUTO_REF:-0}" = 1 ]; then
    say "EXT_PATCHES_REF"  "(auto) → ${EXT_PATCHES_REF:-unresolved — nothing cached for this line}"
  else
    say "EXT_PATCHES_REF"  "${EXT_PATCHES_REF:-(unset)}"
  fi
  # Never echoed: the value is a credential and this output ends up in phase
  # logs, which release-check collects into a bundle.
  say "EXT_PATCHES_TOKEN" "$([ -n "$EXT_PATCHES_TOKEN" ] && echo 'set (redacted)' || { [ "$TOKEN_PLACEHOLDER" = 1 ] && echo '<change-me> (placeholder, not a token)' || echo '(unset)'; })"
  say "EXT_PATCHES_SELECT" "$SELECT"
  say "extension" "${EXT_DIR:-(none on disk)}"
  # The two numbers the mismatch is made of, side by side, so --status answers
  # "is my pin for this bundle?" without anyone having to decode a tag name.
  say "extension version" "$(ext_ver || echo '(unreadable)')"
  say "ref targets" "$(ref_target_ver || echo '(ref names no version)')"
  if [ -n "$SRC" ]; then
    say "source" "$SRC"
  elif [ -n "$CACHE" ]; then
    say "source" "would fetch $EXT_PATCHES_REPO@$EXT_PATCHES_REF"
  elif has_local; then
    # The apply path treats local patchers as a real source (:98-101) and acts
    # on them. --status did not, and answered "nothing configured" for a
    # container whose extension it had just rewritten — the one answer a flag
    # whose whole promise is "say what holds" must never give.
    say "source" "$LOCAL_PATCHERS (this project's own)"
  else
    say "source" "(nothing configured)"
  fi
  # A glob, not `find -printf`: that flag is GNU-only and this has to answer
  # the same way wherever the toolkit runs.
  CACHED=""
  for d in "$CACHE_ROOT"/*/patchers; do
    [ -d "$d" ] || continue
    d="${d%/patchers}"; CACHED="$CACHED${d##*/} "
  done
  say "cached refs" "${CACHED:-(none)}"
  if [ -n "$CACHE" ] && [ -r "$CACHE/versions.json" ]; then
    say "tested versions" "$(python3 -c 'import json,sys
print(" ".join(json.load(open(sys.argv[1])).get("versions") or []))' \
      "$CACHE/versions.json" 2>/dev/null)"
  fi
  # Which object the pinned ref actually is. Recorded by the fetch from the
  # tarball wrapper; absent for a cache that predates it. NOT always a commit:
  # GitHub names the archive after the object the ref resolves to, so an
  # ANNOTATED tag yields its tag object, not the commit it points at (measured:
  # cc2.1.258-r2 -> fe1e5d45, while /tags reports commit 2a11f3d9). Both are
  # immutable and both are fetchable, which is all the pin needs — but calling
  # it a commit would be a lie two thirds of the time.
  [ -n "$CACHE" ] && [ -r "$CACHE/.resolved-sha" ] \
    && say "resolved object" "$(cat "$CACHE/.resolved-sha")"
  if [ -n "$SRC" ] && all_live "$SRC"; then
    say "sentinels" "all live"
  elif [ -n "$SRC" ]; then
    say "sentinels" "not all live — an apply would change the extension"
  fi
  exit 0
fi

# Cache hit or local dir, and the bundle already carries every sentinel:
# nothing to do. This is the nominal restart, and it costs no network.
# --force skips this: ext-patches-update --reapply needs to replay a selection
# against an extension that already carries the markers (a CC bump reinstalls
# the bundle, and the sentinels of the previous copy are gone with it).
# Two questions, not one. `all_live` used to be asked of $SRC alone, which
# ignored the override directory entirely: a project could drop a fixed
# patcher next door, restart, and be told "already applied" because the
# TAGGED patchers' sentinels were all still there. The fixed file never ran,
# and nothing said so. So the set that is checked is the set that would be
# applied — and a changed stamp forces a pass even when every marker is live,
# because an edit that keeps its marker is invisible to a sentinel.
if [ -z "$FORCE" ] && { [ -n "$SRC" ] || [ -z "$CACHE" ]; }; then
  build_work >/dev/null
  if compgen -G "$WORK/*.py" >/dev/null \
     && [ "$(local_stamp)" = "$(cat "$STAMP" 2>/dev/null)" ] \
     && all_live "$WORK"; then
    echo "✓ ext-patches: already applied (sentinels present in $EXT_DIR)"
    # The nominal restart, and the boot a mismatched pin sits in quietly for
    # ever : the sentinels ARE present, because a set for another version did
    # apply. "Already applied" is exactly the sentence that must not stand
    # alone here.
    warn_ref_version_mismatch
    exit 0
  fi
  has_local && [ "$(local_stamp)" != "$(cat "$STAMP" 2>/dev/null)" ] \
    && echo "→ ext-patches: $LOCAL_PATCHERS changed since the last apply"
fi

# --- 3b. fetch ---------------------------------------------------------------
if [ -z "$SRC" ] && [ -n "${CACHE:-}" ]; then
  command -v curl >/dev/null 2>&1 || { banner "curl is missing — cannot fetch patchers."; exit 0; }
  load_proxy
  URL="https://api.github.com/repos/$EXT_PATCHES_REPO/tarball/$EXT_PATCHES_REF"
  TMP=$(mktemp -d); HDR="$TMP/headers"
  echo "→ ext-patches: fetching $EXT_PATCHES_REPO@$EXT_PATCHES_REF"
  # --retry: on a cold create this runs seconds after the firewall came up, and
  # the first attempt can lose the race with dnsmasq and mitmproxy settling —
  # a connection-level failure, before any HTTP status exists. Without a retry
  # the container silently boots unpatched and only recovers at the next
  # post-start. Same flags vendor-fetch.sh already uses for the same reason.
  if curl -fsSL --max-time 60 -D "$HDR" \
       --retry 5 --retry-delay 2 --retry-connrefused --retry-all-errors \
       --retry-max-time 90 \
       -H "Authorization: Bearer $EXT_PATCHES_TOKEN" \
       -H "Accept: application/vnd.github+json" \
       "$URL" -o "$TMP/src.tar.gz" 2>/dev/null; then
    mkdir -p "$CACHE/patchers"
    # The wrapper --strip-components=1 is about to discard is
    # <owner>-<repo>-<sha>, so read the commit out of it while it still exists.
    # It is the ONLY way this container can learn which commit a ref resolved
    # to: the contents API is not on the firewall's allowlist, and /commits is
    # granted for anthropics/* alone. ext-patches-update needs it to turn a
    # HEAD fetch into a pin that names a commit rather than a moving target.
    WRAP=$(tar -tzf "$TMP/src.tar.gz" 2>/dev/null | head -1); WRAP="${WRAP%%/*}"
    # --strip-components=1 drops GitHub's <owner>-<repo>-<sha>/ wrapper.
    if tar -xzf "$TMP/src.tar.gz" -C "$TMP" --strip-components=1 2>/dev/null \
       && compgen -G "$TMP/patchers/*.py" >/dev/null; then
      cp -a "$TMP"/patchers/*.py "$CACHE/patchers/" 2>/dev/null || true
      SRC="$CACHE/patchers"
      case "$WRAP" in *-*) printf '%s\n' "${WRAP##*-}" > "$CACHE/.resolved-sha" ;; esac
      # versions.json travels with the patchers, for warn_untested_version.
      # Copied, not read in place: $TMP is gone three lines from here.
      [ -f "$TMP/versions.json" ] && cp "$TMP/versions.json" "$CACHE/versions.json"
      warn_untested_version "$CACHE"
      # GitHub reports a fine-grained PAT's expiry on authenticated responses.
      # A token created with "No expiration" simply omits it — that is normal,
      # not a parse failure, and it must stay silent.
      EXP=$(sed -n 's/^[Gg]ithub-[Aa]uthentication-[Tt]oken-[Ee]xpiration: *//p' "$HDR" | tr -d '\r' | tail -1)
      if [ -n "$EXP" ]; then printf '%s\n' "$EXP" > "$CACHE/.token-expiration"; fi
    else
      banner "the tarball of $EXT_PATCHES_REF has no patchers/ directory."
    fi
  else
    CODE=$(sed -n 's|^HTTP/[0-9.]* \([0-9]*\).*|\1|p' "$HDR" 2>/dev/null | tail -1)
    case "$CODE" in
      401|403) banner "EXT_PATCHES_TOKEN expired, revoked, or lacking access to $EXT_PATCHES_REPO (HTTP $CODE)." \
                      "Renew it at github.com/settings/personal-access-tokens" ;;
      404)     banner "$EXT_PATCHES_REPO@$EXT_PATCHES_REF not found (HTTP 404)." \
                      "Check the repository and the ref." ;;
      *)       banner "could not fetch $EXT_PATCHES_REPO@$EXT_PATCHES_REF ${CODE:+(HTTP $CODE)}." \
                      "Keeping whatever is cached." ;;
    esac
  fi
  rm -rf "$TMP"
  # A stale cache is better than none: degrade to "the patchers you had".
  [ -z "$SRC" ] && [ -d "$CACHE/patchers" ] && compgen -G "$CACHE/patchers/*.py" >/dev/null \
    && { SRC="$CACHE/patchers"; echo "  … reusing the cached patchers"; }
fi

[ -n "$SRC" ] || has_local || exit 0

# --- 4. merge, then apply ----------------------------------------------------
build_work

if PATCH_DIR="$WORK" PYTHONDONTWRITEBYTECODE=1 \
     "$RESTORE" "$SELECT"; then
  # Written only on success, and only now: a stamp recorded before the apply
  # would make a failed run look like a done one, and the next boot would
  # skip the very patchers that did not land.
  local_stamp > "$STAMP"
  echo "✓ ext-patches: applied selection '$SELECT'"
else
  banner "restore-ext-patches exited non-zero — see the phase log." \
         "The extension is left as it was; the boot continues."
fi

# Last, deliberately: after the apply and after its summary, so a mismatch is
# what you are left looking at rather than something scrolled past. Both
# branches above reach it — a run where every patcher "succeeded" is exactly
# the one this has to reach.
warn_ref_version_mismatch

exit 0
