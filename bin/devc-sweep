#!/bin/bash
# Reclaim the disk a devcontainer fills on its own, without losing anything
# that is still in use. Report only by default: nothing moves without --apply.
#
# Three targets, every one fail-closed:
#   tmp       abandoned mkdtemp dirs at the top of TMP_ROOT (test suites that
#             never clean up — 24 373 of them were found in one container).
#             Deleted only if ALL hold: a directory owned by the caller ; the
#             name has mkdtemp's shape (<prefix>-XXXXXX or tmp.XXXXXXXXXX) ;
#             nothing in it, at any depth, changed for --tmp-hours ; no process
#             has its cwd or an open file inside.
#   scratch   Claude Code's per-session temp dirs, CLAUDE_TMP/<slug>/<uuid>/.
#             Deleted only when that uuid is not a live session (registry +
#             live pid with a matching start time) and nothing in it changed
#             for --tmp-hours.
#   archive   transcripts LOCAL_DIR/projects/<slug>/<uuid>.jsonl (+ the
#             <uuid>/ dir beside it) untouched for --archive-days and not live.
#             ARCHIVED, never deleted : packed to LOCAL_DIR/archive/projects/
#             <slug>/<uuid>.tar.gz, the archive read back in full, and only
#             then the originals removed. `restore` puts them back for /resume.
#
# Usage:
#   devc-sweep [--tmp-hours N] [--archive-days N]          report, removes nothing
#   devc-sweep --apply [--tmp-hours N] [--archive-days N]  do it
#   devc-sweep archived [--project S] [--match T]          archived conversations, with titles
#   devc-sweep show <id-prefix> [--plain]                  read one, without restoring it
#   devc-sweep restore                                     pick in fzf (search, preview, Tab, Ctrl-A)
#   devc-sweep restore <id-prefix>…                        put those back in /resume
#   devc-sweep restore --all [--project S] [--match T] [--yes]
#   devc-sweep list-archived                               every project's archives, raw
#
# "Project" is Claude Code's slug of the current directory (/workspace →
# -workspace) unless --project says otherwise. One archive is one session.
#
# LOCAL_DIR (~/.claude), TMP_ROOT (/tmp) and CLAUDE_TMP (/tmp/claude-<uid>)
# override the roots — the tests point them at a scratch tree.
# DEVC_SWEEP_APPLY_HINT replaces the closing `devc-sweep --apply` hint, for a
# wrapper that calls it under another name (wtf cleanup) ; DEVC_SWEEP_SUMMARY=1
# adds a last line `@@devc-sweep tmp=<n>:<bytes> scratch=… archive=…` for a
# wrapper that totals several containers. DEVC_SWEEP_RESTORE_HINT names the
# browse/restore command in the conversations section (wtf session restore).

set -u
command -v python3 >/dev/null 2>&1 || { echo "devc-sweep: python3 is required" >&2; exit 1; }

export LOCAL_DIR="${LOCAL_DIR:-$HOME/.claude}"
export TMP_ROOT="${TMP_ROOT:-/tmp}"
export CLAUDE_TMP="${CLAUDE_TMP:-/tmp/claude-$(id -u)}"
# The fzf preview calls this script back by path.
export DEVC_SWEEP_SELF="${DEVC_SWEEP_SELF:-$(command -v "$0" 2>/dev/null || echo "$0")}"

# -u: unbuffered, so a wrapper reading through a pipe shows each section as it
# is done rather than everything at the end.
exec python3 -u - "$@" <<'PY'
import glob, json, os, re, shutil, signal, stat, subprocess, sys, tarfile, time

# Piped into head or less and closed early: stop quietly, like any CLI.
signal.signal(signal.SIGPIPE, signal.SIG_DFL)

LOCAL, TMP, CTMP = os.environ['LOCAL_DIR'], os.environ['TMP_ROOT'], os.environ['CLAUDE_TMP']
UID = os.getuid()
TTY = sys.stderr.isatty()
UUID = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
MKDTEMP = re.compile(r'^([A-Za-z0-9._-]+-[A-Za-z0-9]{6}|tmp\.[A-Za-z0-9]{10})$')
ARCHIVE = os.path.join(LOCAL, 'archive', 'projects')
INDEX = os.path.join(LOCAL, 'archive', 'index.tsv')   # sid, slug, date, title
# What the scan deliberately left alone, by reason — printed so the report
# says what is protected, not only what goes.
KEPT = {'recent': 0, 'in_use': 0, 'live': 0, 'young': 0}


def usage(code=2):
    print('usage: devc-sweep [--apply] [--tmp-hours N] [--archive-days N]\n'
          '       devc-sweep archived [--project S] [--match T]\n'
          '       devc-sweep show <id-prefix> [--plain]\n'
          '       devc-sweep restore [<id-prefix>… | --all [--project S] [--match T] [--yes]]\n'
          '       devc-sweep list-archived', file=sys.stderr)
    sys.exit(code)


def tick(msg):
    if TTY:
        sys.stderr.write('\r\033[K  … ' + msg)
        sys.stderr.flush()


def untick():
    if TTY:
        sys.stderr.write('\r\033[K')
        sys.stderr.flush()


def human(n):
    for unit in ('B', 'K', 'M', 'G'):
        if n < 1024 or unit == 'G':
            return ('%.0f%s' if unit in ('B', 'K') else '%.1f%s') % (n, unit)
        n /= 1024.0


def disk_usage(path):
    total = 0
    for root, dirs, files in os.walk(path):
        for name in dirs + files:
            try:
                total += os.lstat(os.path.join(root, name)).st_blocks * 512
            except OSError:
                pass
    try:
        total += os.lstat(path).st_blocks * 512
    except OSError:
        pass
    return total


def touched_since(path, cutoff):
    """True as soon as the dir itself or anything under it changed after cutoff."""
    try:
        if os.lstat(path).st_mtime > cutoff:
            return True
    except OSError:
        return True
    for root, dirs, files in os.walk(path):
        for name in dirs + files:
            try:
                if os.lstat(os.path.join(root, name)).st_mtime > cutoff:
                    return True
            except OSError:
                return True
    return False


# Same rule as claude-account's live_sessions: a registry entry counts only if
# its pid is alive AND started when the registry says (a recycled pid is not
# a session).
def proc_start(pid):
    try:
        with open('/proc/%d/stat' % pid) as f:
            s = f.read()
        return s[s.rindex(')') + 2:].split()[19]
    except Exception:
        return None


def live_sessions():
    live = set()
    for path in glob.glob(os.path.join(LOCAL, 'sessions', '*.json')):
        try:
            with open(path) as f:
                d = json.load(f)
            pid = int(d.get('pid') or os.path.basename(path).split('.')[0])
        except Exception:
            continue
        start = proc_start(pid)
        if start is None:
            continue
        if d.get('procStart') and str(d['procStart']) != start:
            continue
        if d.get('sessionId'):
            live.add(d['sessionId'])
    return live


def open_paths():
    """Every cwd and open file of every process we can see."""
    seen = set()
    for proc in glob.glob('/proc/[0-9]*'):
        for link in [os.path.join(proc, 'cwd')] + glob.glob(os.path.join(proc, 'fd', '*')):
            try:
                seen.add(os.readlink(link))
            except OSError:
                pass
    return seen


def in_use(path, opened):
    prefix = path.rstrip('/') + '/'
    return any(p == path or p.startswith(prefix) for p in opened)


# ---------------------------------------------------------------- candidates
def tmp_candidates(cutoff, opened):
    out = []
    try:
        entries = sorted(os.scandir(TMP), key=lambda e: e.name)
    except OSError:
        return out
    ctmp = os.path.realpath(CTMP)
    for i, e in enumerate(entries, 1):
        if i % 200 == 0:
            tick('scanning %s %d/%d' % (TMP, i, len(entries)))
        if not MKDTEMP.match(e.name):
            continue
        try:
            st = e.stat(follow_symlinks=False)
        except OSError:
            continue
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != UID:
            continue
        if os.path.realpath(e.path) == ctmp:
            continue
        if touched_since(e.path, cutoff):
            KEPT['recent'] += 1
            continue
        if in_use(e.path, opened):
            KEPT['in_use'] += 1
            continue
        out.append(e.path)
    untick()
    return out


def scratch_candidates(cutoff, live, opened):
    out = []
    for slug in sorted(glob.glob(os.path.join(CTMP, '*'))):
        if not os.path.isdir(slug) or os.path.islink(slug):
            continue
        for d in sorted(glob.glob(os.path.join(slug, '*'))):
            name = os.path.basename(d)
            if not UUID.match(name):
                continue
            if name in live:
                KEPT['live'] += 1
                continue
            if not os.path.isdir(d) or os.path.islink(d):
                continue
            tick('checking session dir %s' % name[:8])
            if touched_since(d, cutoff):
                KEPT['recent'] += 1
                continue
            if in_use(d, opened):
                KEPT['in_use'] += 1
                continue
            out.append(d)
    untick()
    return out


def transcript_candidates(cutoff, live):
    out = []
    for f in sorted(glob.glob(os.path.join(LOCAL, 'projects', '*', '*.jsonl'))):
        sid = os.path.basename(f)[:-len('.jsonl')]
        if not UUID.match(sid) or sid in live:
            continue
        try:
            if os.lstat(f).st_mtime > cutoff:
                KEPT['young'] += 1
                continue
        except OSError:
            continue
        side = f[:-len('.jsonl')]
        if os.path.isdir(side) and touched_since(side, cutoff):
            KEPT['young'] += 1
            continue
        out.append(f)
    return out


# ---------------------------------------------------------------- actions
def archive_one(jsonl):
    """Pack <sid>.jsonl (+ <sid>/), read the archive back, then remove the originals."""
    slug = os.path.basename(os.path.dirname(jsonl))
    sid = os.path.basename(jsonl)[:-len('.jsonl')]
    side = jsonl[:-len('.jsonl')]
    dest_dir = os.path.join(ARCHIVE, slug)
    dest = os.path.join(dest_dir, sid + '.tar.gz')
    part = dest + '.part'
    if os.path.exists(dest):
        return 'an archive of this session already exists: %s' % dest
    try:
        with open(jsonl, errors='replace') as f:
            ttl = title_of(f)
        when = time.strftime('%Y-%m-%d %H:%M', time.localtime(os.lstat(jsonl).st_mtime))
    except OSError:
        ttl, when = '', ''
    try:
        os.makedirs(dest_dir, exist_ok=True)
        with tarfile.open(part, 'w:gz') as t:
            t.add(jsonl, arcname=sid + '.jsonl')
            if os.path.isdir(side):
                t.add(side, arcname=sid)
        # Read EVERY member back: a truncated or corrupt gzip fails here, while
        # the originals are still in place.
        with tarfile.open(part, 'r:gz') as t:
            names = t.getnames()
            for m in t.getmembers():
                if m.isfile():
                    fh = t.extractfile(m)
                    while fh.read(1 << 20):
                        pass
        if sid + '.jsonl' not in names:
            raise OSError('the transcript is missing from the archive')
        os.replace(part, dest)
    except Exception as exc:
        try:
            os.remove(part)
        except OSError:
            pass
        return str(exc)
    os.remove(jsonl)
    if os.path.isdir(side):
        shutil.rmtree(side)
    index_add(sid, slug, when, ttl)
    return None


def safe_members(t, sid):
    for m in t.getmembers():
        n = m.name
        if n.startswith('/') or '..' in n.split('/'):
            raise OSError('unsafe path in archive: %s' % n)
        if not (n == sid + '.jsonl' or n == sid or n.startswith(sid + '/')):
            raise OSError('unexpected member in archive: %s' % n)
        if m.issym() or m.islnk() or m.isdev():
            raise OSError('link or device in archive: %s' % n)
    return t.getmembers()


# ---------------------------------------------------------------- archives
def slug_of(path):
    return re.sub(r'[^A-Za-z0-9]', '-', path)


def current_slug():
    """The Claude project you are in: the deepest of the current directory and
    its parents that Claude has sessions or archives for — so from
    /workspace/.devcontainer it is -workspace, where the sessions actually live.
    No match: the current directory's own slug."""
    d = os.getcwd()
    while True:
        sl = slug_of(d)
        if os.path.isdir(os.path.join(LOCAL, 'projects', sl)) or os.path.isdir(os.path.join(ARCHIVE, sl)):
            return sl
        parent = os.path.dirname(d)
        if parent == d:
            return slug_of(os.getcwd())
        d = parent


def gz_size(paths):
    """What these files weigh once gzipped — the archive's size, give or take tar headers."""
    import zlib
    total = 0
    for top in paths:
        files = [top] if os.path.isfile(top) else [os.path.join(r_, f) for r_, _, fs in os.walk(top) for f in fs]
        for f in files:
            c = zlib.compressobj(9, zlib.DEFLATED, 31)
            try:
                with open(f, 'rb') as fh:
                    for chunk in iter(lambda: fh.read(1 << 20), b''):
                        total += len(c.compress(chunk))
                total += len(c.flush())
            except OSError:
                pass
    return total


def title_of(lines):
    """Same rule as claude-account: custom title, else AI title, else last prompt."""
    custom = ai = prompt = ''
    for line in lines:
        if '"custom-title"' not in line and '"ai-title"' not in line and '"last-prompt"' not in line:
            continue
        try:
            e = json.loads(line)
        except Exception:
            continue
        t = e.get('type')
        if t == 'custom-title':
            custom = e.get('customTitle') or custom
        elif t == 'ai-title':
            ai = e.get('aiTitle') or ai
        elif t == 'last-prompt':
            prompt = e.get('lastPrompt') or prompt
    return ' '.join((custom or ai or prompt or '(untitled)').split())[:90]


def index_read():
    idx = {}
    try:
        with open(INDEX, errors='replace') as f:
            for line in f:
                parts = line.rstrip('\n').split('\t')
                if len(parts) == 4:
                    idx[parts[0]] = parts[1:]
    except OSError:
        pass
    return idx


def index_add(sid, slug, when, ttl):
    try:
        os.makedirs(os.path.dirname(INDEX), exist_ok=True)
        with open(INDEX, 'a') as f:
            f.write('%s\t%s\t%s\t%s\n' % (sid, slug, when, ttl.replace('\t', ' ').replace('\n', ' ')))
    except OSError:
        pass


def jsonl_lines(path, sid):
    """The archived transcript's lines, read in memory — nothing is extracted to disk."""
    with tarfile.open(path, 'r:gz') as t:
        m = t.getmember(sid + '.jsonl')
        data = t.extractfile(m).read().decode('utf-8', 'replace')
        return data.splitlines(), m.mtime


def archived():
    """Every archive: (sid, slug, path)."""
    rows = []
    for a in sorted(glob.glob(os.path.join(ARCHIVE, '*', '*.tar.gz'))):
        rows.append((os.path.basename(a)[:-len('.tar.gz')], os.path.basename(os.path.dirname(a)), a))
    return rows


def entries(project=None, match=None):
    """(sid, slug, date, size, title, path), newest first. A pre-index archive gets its
    title read from the tar once, then indexed."""
    idx = index_read()
    out = []
    for sid, slug, a in archived():
        if project and slug != project:
            continue
        if sid in idx and idx[sid][0] == slug:
            when, ttl = idx[sid][1], idx[sid][2]
        else:
            try:
                lines, mtime = jsonl_lines(a, sid)
                ttl = title_of(lines)
                when = time.strftime('%Y-%m-%d %H:%M', time.localtime(mtime))
                index_add(sid, slug, when, ttl)
            except Exception:
                ttl, when = '(unreadable archive)', ''
        if match and match.lower() not in ttl.lower():
            continue
        out.append((sid, slug, when, os.path.getsize(a), ttl, a))
    out.sort(key=lambda e: e[2], reverse=True)
    return out


def resolve(prefix):
    hits = [r for r in archived() if r[0].startswith(prefix)]
    if not hits:
        return None, 'no archived session starts with %s' % prefix
    if len(hits) > 1:
        return None, '%s matches %d archives — give more of the id' % (prefix, len(hits))
    return hits[0], None


def restore_one(sid, slug, a):
    """None when restored, else the reason it was not."""
    target = os.path.join(LOCAL, 'projects', slug)
    for p in (os.path.join(target, sid + '.jsonl'), os.path.join(target, sid)):
        if os.path.exists(p):
            return 'already in /resume (%s exists) — left as is' % p
    os.makedirs(target, exist_ok=True)
    try:
        with tarfile.open(a, 'r:gz') as t:
            t.extractall(target, members=safe_members(t, sid))
    except Exception as exc:
        return 'restore failed, archive kept: %s' % exc
    os.remove(a)
    return None


def restore_many(rows):
    ok = bad = 0
    for sid, slug, a in rows:
        err = restore_one(sid, slug, a)
        if err:
            bad += 1
            print('  ✗ %s  %s' % (sid[:8], err))
        else:
            ok += 1
            print('  ✓ %s  back in /resume (%s)' % (sid[:8], slug))
    print('restored %d, skipped %d' % (ok, bad))
    return 1 if bad else 0


def cmd_list():
    rows = archived()
    if not rows:
        print('no archived transcript under %s' % ARCHIVE)
        return 0
    for sid, slug, a in rows:
        st = os.stat(a)
        print('%s  %s  %6s  %s' % (sid, time.strftime('%Y-%m-%d', time.localtime(st.st_mtime)), human(st.st_size), slug))
    return 0


def cmd_archived(project, match):
    rows = entries(project, match)
    print('archived conversations — project %s%s' % (project, (', title contains "%s"' % match) if match else ''))
    if not rows:
        print('  (none)')
        return 0
    for sid, slug, when, size, ttl, _ in rows:
        print('  %s  %-16s %7s  %s' % (sid[:8], when, human(size), ttl))
    print('%d archived — read one: show <id> ; put back: restore <id>… | restore --all | restore (picker)' % len(rows))
    return 0


def render(lines):
    """A transcript as text: who said what. Tool calls in one line, thinking hidden."""
    out, last = [], None
    for line in lines:
        try:
            e = json.loads(line)
        except Exception:
            continue
        t = e.get('type')
        if t not in ('user', 'assistant') or e.get('isMeta'):
            continue
        content = (e.get('message') or {}).get('content')
        blocks = [{'type': 'text', 'text': content}] if isinstance(content, str) else (content or [])
        parts = []
        for b in blocks:
            if not isinstance(b, dict):
                continue
            if b.get('type') == 'text' and (b.get('text') or '').strip():
                parts.append(b['text'].strip())
            elif b.get('type') == 'tool_use':
                parts.append('[tool: %s]' % b.get('name', '?'))
        if not parts:
            continue      # tool results, thinking-only turns
        who = 'you' if t == 'user' else 'claude'
        if who != last:
            out.append('\n── %s  %s' % (who, (e.get('timestamp') or '')[:16].replace('T', ' ')))
            last = who
        out.extend(parts)
    # A run of tool calls reads as one line: [tools: Bash ×10, Agent ×2].
    merged, run = [], []
    def flush():
        if run:
            counts = {}
            for name in run:
                counts[name] = counts.get(name, 0) + 1
            merged.append('[tools: %s]' % ', '.join('%s ×%d' % (k, v) if v > 1 else k for k, v in counts.items()))
            del run[:]
    for line in out:
        if line.startswith('[tool: ') and line.endswith(']'):
            run.append(line[7:-1])
        else:
            flush()
            merged.append(line)
    flush()
    return merged


def cmd_show(prefix, plain):
    hit, err = resolve(prefix)
    if err:
        print('devc-sweep: %s' % err, file=sys.stderr)
        return 1
    sid, slug, a = hit
    try:
        lines, mtime = jsonl_lines(a, sid)
    except Exception as exc:
        print('devc-sweep: cannot read %s: %s' % (a, exc), file=sys.stderr)
        return 1
    body = render(lines)
    head = ['%s' % title_of(lines),
            'session %s · project %s · last activity %s · %d prompts · archived (restore %s)' % (
                sid, slug, time.strftime('%Y-%m-%d %H:%M', time.localtime(mtime)),
                sum(1 for l in body if l.startswith('\n── you')), sid[:8])]
    text = '\n'.join(head + body) + '\n'
    if not plain and sys.stdout.isatty() and shutil.which('less'):
        subprocess.run(['less', '-R'], input=text.encode())
    else:
        sys.stdout.write(text)
    return 0


def cmd_restore(ids, all_, project, match, yes):
    if ids:
        rows, bad = [], 0
        for p in ids:
            hit, err = resolve(p)
            if err:
                print('  ✗ %s' % err)
                bad += 1
            else:
                rows.append(hit)
        rc = restore_many(rows) if rows else 0
        return 1 if (bad or rc) else 0
    picked = entries(project, match)
    if all_:
        if not picked:
            print('nothing archived for project %s%s' % (project, (' matching "%s"' % match) if match else ''))
            return 0
        print('%d conversation(s) will go back to /resume (project %s):' % (len(picked), project))
        for sid, _, when, _, ttl, _ in picked:
            print('  %s  %-16s %s' % (sid[:8], when, ttl))
        if not yes:
            try:
                with open('/dev/tty') as tty:
                    sys.stdout.write('restore them? [y/N] ')
                    sys.stdout.flush()
                    answer = tty.readline().strip().lower()
            except OSError:
                print('no terminal to confirm — add --yes', file=sys.stderr)
                return 2
            if answer not in ('y', 'yes', 'o', 'oui'):
                print('nothing restored')
                return 0
        return restore_many([(sid, slug, a) for sid, slug, _, _, _, a in picked])
    # No id, no --all: the picker.
    # stdin is this script's own source (python3 - <<PY), so the terminal test
    # is on stdout plus a usable /dev/tty — which is where fzf reads keys.
    try:
        open('/dev/tty').close()
        has_tty = sys.stdout.isatty()
    except OSError:
        has_tty = False
    if not has_tty or not shutil.which('fzf'):
        usage()
    if not picked:
        print('nothing archived for project %s' % project)
        return 0
    lines = '\n'.join('%s\t%s  %7s  %s' % (sid, when, human(size), ttl)
                      for sid, _, when, size, ttl, _ in picked)
    me = os.environ.get('DEVC_SWEEP_SELF', 'devc-sweep')
    res = subprocess.run(
        ['fzf', '--multi', '--delimiter', '\t', '--with-nth', '2..', '--reverse',
         '--header', 'project %s — type to search · Tab: select · Ctrl-A: all · Enter: restore · Esc: quit' % project,
         '--preview', '%s show {1} --plain' % me, '--preview-window', 'right:60%:wrap',
         '--bind', 'ctrl-a:select-all'],
        input=lines.encode(), stdout=subprocess.PIPE)
    chosen = [l.split('\t', 1)[0] for l in res.stdout.decode().splitlines() if l]
    if not chosen:
        print('nothing restored')
        return 0
    by_sid = {sid: (sid, slug, a) for sid, slug, _, _, _, a in picked}
    return restore_many([by_sid[c] for c in chosen if c in by_sid])


# ---------------------------------------------------------------- main
def main(argv):
    apply, tmp_hours, archive_days, rest = False, 24.0, 30.0, []
    all_, yes, plain, project, match = False, False, False, current_slug(), None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == '--apply':
            apply = True
        elif a in ('--tmp-hours', '--archive-days') and i + 1 < len(argv):
            try:
                v = float(argv[i + 1])
            except ValueError:
                usage()
            if v < 0:
                usage()
            if a == '--tmp-hours':
                tmp_hours = v
            else:
                archive_days = v
            i += 1
        elif a in ('--project', '--match') and i + 1 < len(argv):
            if a == '--project':
                project = argv[i + 1]
            else:
                match = argv[i + 1]
            i += 1
        elif a == '--all':
            all_ = True
        elif a == '--yes':
            yes = True
        elif a == '--plain':
            plain = True
        elif a in ('-h', '--help'):
            usage(0)
        elif a.startswith('-'):
            usage()
        else:
            rest.append(a)
        i += 1

    if rest[:1] == ['list-archived'] and len(rest) == 1:
        return cmd_list()
    if rest[:1] == ['show'] and len(rest) == 2:
        return cmd_show(rest[1], plain)
    if rest[:1] in (['archived'], ['restore']):
        if rest[0] == 'archived':
            return cmd_archived(project, match) if len(rest) == 1 else usage()
        return cmd_restore(rest[1:], all_, project, match, yes)
    if rest:
        usage()

    now = time.time()
    tmp_cut = now - tmp_hours * 3600
    arc_cut = now - archive_days * 86400
    tick('reading the session registry and open files')
    live = live_sessions()
    opened = open_paths()
    untick()

    # (key, title, why it is safe, candidates, verb, summary label)
    groups = [
        ('tmp', 'Temp dirs left behind by test runs — %s/<name>-XXXXXX' % TMP,
         ['created by mkdtemp and never removed by the program that made them ;',
          'kept if anything in them changed in the last %gh or a process uses them.' % tmp_hours,
          '/tmp is wiped at every container rebuild anyway — nothing durable lives there.'],
         tmp_candidates(tmp_cut, opened), 'delete', 'test temp dirs'),
        ('scratch', 'Working files of Claude sessions that have ended — %s/<project>/<session>/' % CTMP,
         ['each session\'s scratchpad and tool outputs, not its conversation ;',
          'kept while the session runs, and for %gh after anything in it changed.' % tmp_hours],
         scratch_candidates(tmp_cut, live, opened), 'delete', 'ended sessions\' files'),
        ('archive', 'Conversations not touched for %g days — %s/projects/' % (archive_days, LOCAL),
         ['ARCHIVED, not deleted: compressed to %s/archive/ and gone from /resume ;' % LOCAL,
          '`%s` lists, reads and puts them back.' % os.environ.get('DEVC_SWEEP_RESTORE_HINT', 'devc-sweep restore')],
         transcript_candidates(arc_cut, live), 'archive', 'old conversations'),
    ]

    print('devc-sweep  mode=%s  live Claude sessions (never touched): %d' % ('APPLY' if apply else 'report only — nothing is removed', len(live)))
    grand, failed, summary = 0, 0, []
    for key, title, why, items, verb, label in groups:
        sized = []
        for n, p in enumerate(items, 1):
            if n % 100 == 0:
                tick('sizing %s %d/%d' % (key, n, len(items)))
            sz = disk_usage(p)
            gz = 0
            if verb == 'archive':
                side = p[:-len('.jsonl')]
                if os.path.isdir(side):
                    sz += disk_usage(side)
                tick('compressing %s %d/%d (measuring the gain)' % (key, n, len(items)))
                gz = gz_size([p] + ([side] if os.path.isdir(side) else []))
            # The gain: everything for a deletion ; original minus archive for an
            # archive, since the archive stays on the same volume.
            sized.append((sz, p, gz, max(sz - gz, 0) if verb == 'archive' else sz))
        untick()
        sized.sort(reverse=True)
        total = sum(g for _, _, _, g in sized)
        print('\n── %s' % title)
        for line in why:
            print('   %s' % line)
        if not sized:
            print('  (nothing)')
            summary.append((key, label, verb, 0, 0))
            continue
        for sz, p, gz, _ in sized[:8]:
            if verb == 'archive':
                print('  %7s → %6s  %s' % (human(sz), human(gz), p))
            else:
                print('  %7s  %s' % (human(sz), p))
        if len(sized) > 8:
            print('  …and %d more' % (len(sized) - 8))
        if verb == 'archive':
            print('  %d item(s), %s → %s archived, %s gained' % (
                len(sized), human(sum(x[0] for x in sized)), human(sum(x[2] for x in sized)), human(total)))
        else:
            print('  %d item(s), %s' % (len(sized), human(total)))
        if not apply:
            grand += total
            summary.append((key, label, verb, len(sized), total))
            continue
        done, done_b = 0, 0
        for n, (sz, p, _, gain) in enumerate(sized, 1):
            tick('%s %d/%d' % ('archiving' if verb == 'archive' else 'removing', n, len(sized)))
            if verb == 'archive':
                err = archive_one(p)
            else:
                try:
                    shutil.rmtree(p)
                    err = None
                except OSError as exc:
                    err = str(exc)
            if err:
                failed += 1
                untick()
                print('  ✗ %s — %s (kept)' % (p, err))
            else:
                done += 1
                done_b += gain
        untick()
        print('  ✓ %d %s' % (done, 'archived' if verb == 'archive' else 'removed'))
        grand += done_b
        summary.append((key, label, verb, done, done_b))

    # The short version: one line per kind, then the total.
    print('\n── summary')
    for key, label, verb, n, b in summary:
        what = ('archived' if apply else 'to archive') if verb == 'archive' else ('removed' if apply else 'to remove')
        print('  %-24s %6d  %8s  %s' % (label, n, human(b), what if n else '—'))
    print('  %-24s %6s  %8s  %s' % ('total', '', human(grand), 'freed' if apply else 'to free'))
    print('  (an archive stays on the volume: its line counts only what compression gains)')
    print('\n  left alone, on purpose:')
    print('    %d running Claude session(s) — their files and conversations' % len(live))
    print('    %d dir(s) changed in the last %gh, %d dir(s) a process is using' % (KEPT['recent'], tmp_hours, KEPT['in_use']))
    print('    %d conversation(s) younger than %g days — still in /resume' % (KEPT['young'] + len(live), archive_days))
    if not failed:
        print('  ✓ %s' % ('done — nothing in use was touched.' if apply else
                          'safe to apply: everything listed is idle and unused — leftover temp files'
                          ' nothing reads any more, or conversations archived (restorable).'))
    if not apply and grand:
        # A wrapper (wtf cleanup) names its own command, so the hint is one the
        # user can actually type where they are.
        print('  nothing was touched — run `%s` to do it' % os.environ.get('DEVC_SWEEP_APPLY_HINT', 'devc-sweep --apply'))
    # Machine-readable totals for a wrapper aggregating several containers.
    if os.environ.get('DEVC_SWEEP_SUMMARY') == '1':
        print('@@devc-sweep ' + ' '.join('%s=%d:%d' % (k, n, b) for k, _, _, n, b in summary))
    return 1 if failed else 0


sys.exit(main(sys.argv[1:]))
PY
