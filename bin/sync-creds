#!/bin/bash
# Bidirectional sync of Claude Code .credentials.json between:
#   - local  /home/node/.claude/.credentials.json       (per-project volume)
#   - shared /home/node/.claude-creds/.credentials.json (external volume, shared across projects)
#     — that root is account "default" ; another active account (claude-account)
#     resolves to /home/node/.claude-creds/accounts/<name>/.credentials.json
#
# Decision rule: copy from the side whose OAuth access token has the higher
# expiresAt (most recently refreshed token wins). Same-token => no-op.
# Both valid but different tokens => flag /tmp/.claude-creds-conflict for
# interactive resolution at next terminal open.
#
# Modes:
#   (default)         silent — used by Claude Code hooks (Stop / SessionEnd)
#   --verbose / VERBOSE=1   prints the usual "✓ Credentials synced..." line
#   DEBUG=1           prints decision details to stderr
#
# Always exits 0 so a hook failure never blocks Claude.

set +e

LOCAL_CRED="${LOCAL_CRED:-${LOCAL_DIR:-/home/node/.claude}/.credentials.json}"

if [ "${1:-}" = "--verbose" ] || [ "${VERBOSE:-0}" = "1" ]; then
  VERBOSE=1
else
  VERBOSE=0
fi

log()   { [ "$VERBOSE" = "1" ] && echo "$*"; return 0; }
debug() { [ "${DEBUG:-0}" = "1" ] && echo "[sync-creds] $*" >&2; return 0; }

# Bail silently if python3 is missing (nothing we can do — JSON parse required)
command -v python3 >/dev/null 2>&1 || { debug "python3 missing, skipping"; exit 0; }

# One sync at a time, across containers: resolve + decide + copy run under a
# lock at the root of the creds volume. That volume is a real fs shared by every
# container, so the lock serialises them all ; a lock in /tmp would serialise
# one container only, and one under /workspace grants itself to everybody
# (knowledge/workspace-mount.md). `claude-account use` holds the same lock while
# it swaps .active-account and the local creds, so a sync never pairs the new
# slot with the old account's token. /tmp when the volume is absent. A lock
# still busy after 10 s means a sync is running anyway: skip.
if command -v flock >/dev/null 2>&1; then
  if [ -n "${SHARED_CRED:-}" ] && [ -z "${SHARED_DIR:-}" ]; then
    _lockdir=$(dirname "$SHARED_CRED")
  else
    _lockdir="${SHARED_DIR:-/home/node/.claude-creds}"
  fi
  [ -d "$_lockdir" ] || _lockdir=/tmp
  _lock="$_lockdir/.sync-creds.lock"
  # Probe in a subshell first: a failed `exec` redirection aborts dash.
  if (: >>"$_lock") 2>/dev/null; then
    exec 9>>"$_lock"
    flock -w 10 9 || { debug "lock busy ($_lock), skipping"; exit 0; }
  fi
fi

# The active account's slot, from the one resolver (`claude-account path`) ; the
# root (account "default", the only one 1.9.x knows) when the resolver is absent.
# POSIX on purpose: the Stop / SessionEnd hooks run this file with `sh`.
if [ -z "${SHARED_CRED:-}" ]; then
  _resolver="$(dirname "$0")/claude-account"
  [ -x "$_resolver" ] || _resolver=$(command -v claude-account 2>/dev/null)
  [ -n "$_resolver" ] && SHARED_CRED=$("$_resolver" path 2>/dev/null)
  SHARED_CRED="${SHARED_CRED:-${SHARED_DIR:-/home/node/.claude-creds}/.credentials.json}"
fi

# Copy through a tmp file in the target's own directory, then rename: same fs,
# so the mv is atomic and no reader (the CLI, another container) ever sees a
# half-written JSON. Mode 600 on both sides — the token is the same secret.
atomic_cp() {
  _tmp="$2.tmp.$$"
  if cp "$1" "$_tmp" 2>/dev/null && chmod 600 "$_tmp" 2>/dev/null && mv -f "$_tmp" "$2" 2>/dev/null; then
    return 0
  fi
  rm -f "$_tmp" 2>/dev/null
  return 1
}

# Decide action: same | local-newer | shared-newer | conflict | none
ACTION=$(python3 -c "
import json, os, sys, time

local, shared = sys.argv[1], sys.argv[2]
lx = os.path.isfile(local)
sx = os.path.isfile(shared)
if not lx and not sx:
    print('none'); sys.exit()
if lx and not sx:
    print('local-only'); sys.exit()
if sx and not lx:
    print('shared-only'); sys.exit()

try:
    with open(local) as f:  l = json.load(f).get('claudeAiOauth', {})
    with open(shared) as f: s = json.load(f).get('claudeAiOauth', {})
except Exception as e:
    print('same'); sys.exit()

lt = l.get('accessToken', '')
st = s.get('accessToken', '')
le = int(l.get('expiresAt', 0) or 0)
se = int(s.get('expiresAt', 0) or 0)
now = int(time.time() * 1000)
lv = le > now
sv = se > now

if lt and lt == st:
    print('same')
elif le > se and lv:
    print('local-newer')
elif se > le and sv:
    print('shared-newer')
elif lv and sv and lt != st:
    print('conflict')
else:
    print('same')
" "$LOCAL_CRED" "$SHARED_CRED" 2>/dev/null)

debug "action=$ACTION local=$LOCAL_CRED shared=$SHARED_CRED"

case "$ACTION" in
  same)
    log "✓ Credentials already in sync"
    ;;
  local-newer)
    atomic_cp "$LOCAL_CRED" "$SHARED_CRED" && \
      log "✓ Credentials synced to shared (token refreshed)"
    ;;
  shared-newer)
    atomic_cp "$SHARED_CRED" "$LOCAL_CRED" && \
      log "✓ Credentials synced from shared (newer token)"
    ;;
  local-only)
    mkdir -p "$(dirname "$SHARED_CRED")" 2>/dev/null
    atomic_cp "$LOCAL_CRED" "$SHARED_CRED" && \
      log "✓ Credentials saved to shared volume"
    ;;
  shared-only)
    mkdir -p "$(dirname "$LOCAL_CRED")" 2>/dev/null
    atomic_cp "$SHARED_CRED" "$LOCAL_CRED" && \
      log "✓ Credentials restored from shared volume"
    ;;
  conflict)
    echo "conflict" > /tmp/.claude-creds-conflict
    log "⚠️  Credentials conflict (both valid, different tokens). Open a terminal to resolve."
    ;;
  none|*)
    debug "no credentials present, nothing to sync"
    ;;
esac

exit 0
