#!/usr/bin/env bash
# devc-hook <phase> [--dry-run]
#
# Lightweight dispatcher for devcontainer lifecycle hooks. Enumerates
# fragments from three layers, dedups by filename (last layer wins), sorts by
# numeric prefix, and executes each. Honors a `disabled.txt` in each layer —
# same line format as the firewall allowlists — unioned with the deprecated
# `customizations.stitchu-devc.disabledHooks` of devcontainer.json.
#
# The three layers, in resolution order :
#   base     the image itself                     /opt/devcontainer/base/hooks
#   ext      a Dockerfile that FROMs the image    /opt/devcontainer/ext/hooks
#   overlay  the project's workspace              /workspace/.devcontainer/hooks
#
# `ext` exists so an extending image does NOT write into the base layer. Same
# directory would mean Docker overwrites the base fragment on disk : the
# original is gone, nothing says which layer a fragment came from, and the
# @required protection below is bypassed by simply shadowing the file.
#
# Fragment header keys parsed :
#   # @required true|false   — if true, fragment exit != 0 aborts the phase,
#                              and the fragment cannot be disabled without the
#                              explicit `!` opt-in (see disabledHooks below).
#
# Path resolution (portable across dogfood + image install) :
#   DEVC_BASE_HOOKS      — default: <script>/../hooks, fallback /opt/devcontainer/base/hooks
#   DEVC_EXT_HOOKS       — default: /opt/devcontainer/ext/hooks
#   DEVC_OVERLAY_HOOKS   — default: /workspace/.devcontainer/hooks
#   DEVC_CONFIG_DIR      — default: /workspace/.devcontainer  (for devcontainer.json + logs)
#   DEVC_CONF_LIB        — default: /usr/local/bin/devc-conf.sh (the .txt parser)

set -eEuo pipefail

# --- Args ------------------------------------------------------------------
PHASE="${1:?usage: devc-hook <phase> [--dry-run]}"
DRY_RUN=false
[[ "${2:-}" == "--dry-run" ]] && DRY_RUN=true

case "$PHASE" in
  on-create|post-create|post-start|initialize) ;;
  *) echo "devc-hook: unknown phase '$PHASE'" >&2; exit 2 ;;
esac

# --- Path resolution -------------------------------------------------------
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -z "${DEVC_BASE_HOOKS:-}" ]; then
  if [ -d "$SELF_DIR/../hooks" ]; then
    DEVC_BASE_HOOKS="$(cd "$SELF_DIR/../hooks" && pwd)"
  else
    DEVC_BASE_HOOKS=/opt/devcontainer/base/hooks
  fi
fi
DEVC_EXT_HOOKS="${DEVC_EXT_HOOKS:-/opt/devcontainer/ext/hooks}"
DEVC_OVERLAY_HOOKS="${DEVC_OVERLAY_HOOKS:-/workspace/.devcontainer/hooks}"
DEVC_CONFIG_DIR="${DEVC_CONFIG_DIR:-/workspace/.devcontainer}"

BASE_D="$DEVC_BASE_HOOKS/${PHASE}.d"
EXT_D="$DEVC_EXT_HOOKS/${PHASE}.d"
OVL_D="$DEVC_OVERLAY_HOOKS/${PHASE}.d"
FLAT="$DEVC_OVERLAY_HOOKS/${PHASE}.sh"

# --- The two sinks ---------------------------------------------------------
# The LOG keeps everything, plain: no SGR, so `grep -c '^✗' post-start-*.log` is
# a real answer. The TERMINAL keeps a curated view, coloured. Nothing is
# deleted — the router only decides which channel a line goes to, and a line the
# terminal does not show is in the file one line earlier than it would have been
# printed. Same contract as the host half of this boot:
# devcontainer-cli/src/lib/logger.ts:122-141, where styled() writes SGR to the
# terminal and plain to the sink, and rawToLogOnly() is literally "a child line
# that belongs in the log only".
#
# The rule is the line's FIRST VISIBLE CHARACTER, not its fd and not its column.
#   an fd rule cannot work — on-create.d/10-firewall-init.sh already folds
#     init-firewall's stderr into its stdout, so by the time we see a line the
#     two channels are indistinguishable.
#   a column rule cannot work either — indents run 2 and 3 spaces, the phase
#     header below is 2-space METADATA, and the boot panel's warning reasons are
#     indented warnings that must be seen.
# So: a sigil at column 0 is a verdict; ⚠ and ✗ are alarms at any indentation
# and CARRY their indented repair lines with them; everything else is the log's.
#
# A third-party fragment needs no library, no fd and no colour code: print
# `⚠ `, `✗ `, `✓ ` or `→ ` at column 0 to be seen, indent the repair. One that
# prints ❌ because that is its house style is normalised here, not rejected.
#
# DEVC_HOOK_VERBOSE=1 makes the terminal equal the log. It is the operator's
# rollback (set it in .devcontainer/.env, no rebuild) and what lets
# test/overlay.test.sh keep asserting on the stream it was written against.
devc_route() {
  trap - ERR; set +eE     # a hiccup in here must neither print nor kill the sink
  shopt -s extglob        # confined to this subshell; buys a fork-free SGR strip
  local line plain indent body sgr show carry=0 verbose=0
  [ "${DEVC_HOOK_VERBOSE:-0}" = 1 ] && verbose=1
  # One open fd, one write(2) per printf: line-granular durability, the same
  # reason logger.ts:179 uses writeSync rather than a stream.
  exec 4>>"$LOG"
  while IFS= read -r line || [ -n "$line" ]; do
    plain=${line//$'\033'\[*([0-9;])m/}
    indent=${plain%%[![:space:]]*}
    body=${plain#"$indent"}
    # One vocabulary, in the log and on screen, without rewriting eight
    # producers. Glob prefixes compare bytewise, which is why '⚠'* matches the
    # emoji form ⚠️ (= ⚠ + U+FE0F) and why a character CLASS would be wrong: in
    # a byte-oriented matcher [╔║] also matches → ✓ ⚠, all four sharing 0xE2.
    case "$body" in
      '❌'*)  body="✗${body#❌}"  ;;
      '✘'*)  body="✗${body#✘}"  ;;
      '✅'*)  body="✓${body#✅}"  ;;
      '✔'*)  body="✓${body#✔}"  ;;
      '⚠️'*) body="⚠${body#⚠️}" ;;
    esac
    plain="$indent$body"
    show=0; sgr=''
    case "$body" in
      '✗'*)  show=1; sgr='1;31'; carry=1 ;;
      '⚠'*)  show=1; sgr='1;33'; carry=1 ;;
      '✓'*)  [ -z "$indent" ] && show=1; sgr='0;32'; carry=0 ;;
      # Shown at any indentation, unlike ✓. A `→` is a step STARTING, and a
      # tool that narrates a long pass emits its sub-steps indented under its
      # own step — the patcher pass, sixteen of them over eighteen seconds. It
      # is unambiguous because the dispatcher's own bookkeeping (`run`, `skip`,
      # `run flat overlay`) carries no sigil: those are the phase's index, and
      # the index belongs to the file.
      '→'*)  show=1;                                 carry=0 ;;
      '╔'*|'╠'*|'╚'*|'║'*)
             [ -z "$indent" ] && { show=1; sgr=raw; carry=1; } ;;
      '==='*) [ -z "$indent" ] && show=1;            carry=0 ;;
      # The dispatcher's own index, and the one line that ENDS a carry. A `⚠`
      # arms carry so its repair travels with it, but a fragment boundary is
      # where a repair stops: measured, `⚠ Claude Code 2.1.282 available` armed
      # carry and the next fragment's index line rode onto the screen as if it
      # were the fix. Recognised by shape rather than by a marker because the
      # router and the writer are this same file.
      # Matched on $body, which has had its indent stripped — so no leading
      # spaces in the pattern. The first attempt at this carried them and
      # therefore never fired, which is why the leak survived a release build.
      'run '*|'skip '*)
             show=0; carry=0 ;;
      *)     sgr=raw
             if [ -n "$indent" ] && [ "$carry" = 1 ]; then show=1; else carry=0; fi ;;
    esac
    printf '%s\n' "$plain" >&4
    [ "$verbose" = 1 ] && show=1
    [ "$show" = 1 ] || continue
    case "$sgr" in
      raw) printf '%s\n' "$line"  >&3 ;;   # the panel keeps its own colours
      '')  printf '%s\n' "$plain" >&3 ;;
      *)   printf '\033[%sm%s\033[0m\n' "$sgr" "$plain" >&3 ;;
    esac
  done
  exec 4>&-
}

# Baked at image build (Dockerfile's last layer), independent of the pin a
# rebuilt image may already have bumped past. Same read as boot-summary:91,
# computed unconditionally — a required fragment aborting the phase must
# never be the reason this line goes missing (see devc-hook's `img:` row
# below). Images predating 8424451 lack the file: empty is the baseline, not
# an error.
BASE_VER="$(cat /etc/devcontainer-base-version 2>/dev/null | tr -d '[:space:]')" || true

# --- Lifecycle logging (dispatcher owns tee + xtrace + ERR trap) -----------
# In --dry-run we keep stdout pristine on the caller's terminal.
if ! $DRY_RUN; then
  mkdir -p "$DEVC_CONFIG_DIR/tmp/logs" 2>/dev/null || true
  TS=$(date +%Y%m%d-%H%M%S)
  LOG="$DEVC_CONFIG_DIR/tmp/logs/${PHASE}-${TS}.log"
  TRACE="$DEVC_CONFIG_DIR/tmp/logs/${PHASE}-${TS}.trace"
  # Exported so a fragment can NAME the log this phase is writing instead of
  # re-globbing for the newest one and racing a concurrent phase. The boot
  # panel (post-start.d/95) is the first consumer.
  export DEVC_PHASE_LOG="$LOG"
  # The phase itself, for tools that must answer "is there an extension host
  # running yet?" — on-create is the one phase where the answer is no.
  export DEVC_PHASE="$PHASE"
  exec 3>&1                        # the real terminal, saved before anything moves
  exec > >(devc_route) 2>&1
  ROUTE_PID=$!
  # There was no `wait` on the sink and no EXIT trap here. A process
  # substitution is reaped by nobody, and exiting first can truncate the file
  # mid-sentence — `=== $PHASE done ===` is both the last line and an asserted
  # one, so it is exactly the line that goes missing. Same fix, same words, as
  # test/release-check.sh:125. Closing fd 1 and 2 is what makes the sink see
  # EOF; the wait is what makes us outlive its last write. Both, in that order.
  devc_flush() {
    local rc=$?
    trap - EXIT ERR
    exec 1>&- 2>&-
    [ -n "${ROUTE_PID:-}" ] && wait "$ROUTE_PID" 2>/dev/null
    exit "$rc"
  }
  trap devc_flush EXIT
  if [ "${DEBUG:-0}" = "1" ]; then
    exec 19>>"$TRACE"
    export BASH_XTRACEFD=19
    PS4='+ ${BASH_SOURCE##*/}:${LINENO}: '
    set -x
    TRACE_LOC="${TRACE#/workspace/}"
  else
    rm -f "$TRACE"
    TRACE_LOC="(disabled — set DEBUG=1 in .env to enable xtrace)"
  fi
  trap 'rc=$?; [ $rc -ne 0 ] && echo "✗ FAIL at ${BASH_SOURCE##*/}:${LINENO} (exit $rc): $BASH_COMMAND" >&2' ERR
  echo "=== $PHASE $(date) ==="
  # Promoted: a simple display is only affordable if it says where the
  # complete one is. The four rows under it stay 2-space metadata.
  echo "→ log   ${LOG#/workspace/}"
  echo "  trace: $TRACE_LOC"
  echo "  img:   ${BASE_VER:-(version unknown)}"
  echo "  base:  ${DEVC_BASE_HOOKS}"
  echo "  ext:   ${DEVC_EXT_HOOKS}"
  echo "  ovl:   ${DEVC_OVERLAY_HOOKS}"
else
  echo "=== $PHASE (dry-run) ==="
  echo "  img:   ${BASE_VER:-(version unknown)}"
  echo "  base:  ${DEVC_BASE_HOOKS}"
  echo "  ext:   ${DEVC_EXT_HOOKS}"
  echo "  ovl:   ${DEVC_OVERLAY_HOOKS}"
fi

# --- Load the disabled list ------------------------------------------------
# Four sources, unioned. `disabled.txt` is the current spelling — same format
# as the firewall allowlists, one `<phase>.d/<fragment>.sh` per line — read
# from each of the three layers, so an extending image can switch off a base
# fragment WITHOUT shadowing it (shadowing bypasses the @required guard, which
# is exactly what that guard exists to prevent).
#
# devcontainer.json's customizations.stitchu-devc.disabledHooks is kept as a
# deprecated alias, so nothing that already works breaks.
#
# An entry may carry a leading `!` — the explicit opt-in required to switch off
# a fragment that declares `@required true`. It is kept in the list so
# disabled_mode() can tell a plain request from a forced one.
# Sibling first, then the image location — the same resolution DEVC_BASE_HOOKS
# gets above, so running this straight out of the repo needs no env var.
if [ -z "${DEVC_CONF_LIB:-}" ]; then
  if [ -r "$SELF_DIR/devc-conf.sh" ]; then
    DEVC_CONF_LIB="$SELF_DIR/devc-conf.sh"
  else
    DEVC_CONF_LIB=/usr/local/bin/devc-conf.sh
  fi
fi
if [ ! -r "$DEVC_CONF_LIB" ]; then
  echo "⚠ $DEVC_CONF_LIB missing — disabled.txt left unread, every fragment will run" >&2
else
  # shellcheck source=/dev/null
  . "$DEVC_CONF_LIB"
fi

# Entries for other phases are collected too, and that is fine: disabled_mode()
# matches the FULL key (`post-start.d/10-alpha.sh`) exactly, so an on-create
# entry can never match here. Filtering by phase first would be a second,
# untestable spelling of the same rule.
DISABLED_LIST=""
if [ -r "$DEVC_CONF_LIB" ]; then
  for D_TXT in "$DEVC_BASE_HOOKS/disabled.txt" \
               "$DEVC_EXT_HOOKS/disabled.txt" \
               "$DEVC_OVERLAY_HOOKS/disabled.txt"; do
    D=$(conf_entries "$D_TXT")
    [ -n "$D" ] && DISABLED_LIST="$DISABLED_LIST"$'\n'"$D"
  done
fi

# The JSONC alias. `devcontainer.json` is JSON *with comments*, and the shell
# has no parser for that — the previous `sed -E 's://.*$::' | jq` cut `//`
# inside strings too, so a single `"docs": "https://…"` made the file
# unparseable and silently dropped the WHOLE list. python3 is a hard
# dependency of this image, so the strip is done properly instead: string- and
# escape-aware, and trailing commas (legal JSONC, also fatal to jq) go too.
if ! command -v python3 >/dev/null 2>&1 &&
   { [ -f "$DEVC_CONFIG_DIR/devcontainer.json" ] || [ -f "$DEVC_CONFIG_DIR/devcontainer.local.json" ]; }; then
  # Silence here used to mean "nothing is disabled" and "the list was never
  # read" at the same time. They are not the same thing.
  echo "⚠ python3 not found — disabledHooks left unread, every fragment will run" >&2
fi
for CONF in "$DEVC_CONFIG_DIR/devcontainer.local.json" "$DEVC_CONFIG_DIR/devcontainer.json"; do
  [ -f "$CONF" ] || continue
  command -v python3 >/dev/null 2>&1 || continue
  PY_ERR=""
  D=$(python3 -c '
import json, sys

def strip_jsonc(text):
    """Drop // and /* */ comments, and trailing commas, outside strings."""
    out, i, n = [], 0, len(text)
    while i < n:
        c = text[i]
        if c == "\"":
            out.append(c); i += 1
            while i < n:
                out.append(text[i])
                if text[i] == "\\": # an escape swallows the next character
                    if i + 1 < n:
                        out.append(text[i + 1]); i += 2
                        continue
                elif text[i] == "\"":
                    i += 1
                    break
                i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            while i < n and text[i] != "\n":
                i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "*":
            end = text.find("*/", i + 2)
            i = n if end < 0 else end + 2
            continue
        if c == ",":
            j = i + 1
            while j < n and text[j] in " \t\r\n":
                j += 1
            if j < n and text[j] in "}]":
                i += 1          # trailing comma: legal JSONC, fatal to json
                continue
        out.append(c); i += 1
    return "".join(out)

with open(sys.argv[1], encoding="utf-8") as f:
    conf = json.loads(strip_jsonc(f.read()))
listed = conf.get("customizations", {}).get("stitchu-devc", {}).get("disabledHooks") or []
for entry in listed:
    if isinstance(entry, str):
        print(entry)
' "$CONF" 2>&1) || PY_ERR=1
  if [ -n "$PY_ERR" ]; then
    echo "⚠ ${CONF##*/} could not be parsed — its disabledHooks are ignored" >&2
    echo "    ${D##*$'\n'}" >&2
    continue
  fi
  [ -n "$D" ] && DISABLED_LIST="$DISABLED_LIST"$'\n'"$D"
done

# "" = not listed | soft = listed | force = listed with the `!` opt-in.
disabled_mode() {
  local key="$1"
  if printf '%s\n' "$DISABLED_LIST" | grep -Fxq "!$key"; then
    echo force
  elif printf '%s\n' "$DISABLED_LIST" | grep -Fxq "$key"; then
    echo soft
  fi
}

# --- Enumerate + dedup by basename (last layer wins) -----------------------
# LAYER remembers where the winner came from, so the run log can say it.
# MASKED_REQ remembers a shadowed fragment that declared `@required true` —
# an extending image or a project silently replacing the firewall bring-up is
# exactly what the @required guard exists to prevent, and shadowing is the
# route that does not go through disabledHooks.
declare -A SEEN LAYER MASKED_REQ
for LYR in base ext ovl; do
  case "$LYR" in
    base) DIR="$BASE_D" ;;
    ext)  DIR="$EXT_D"  ;;
    ovl)  DIR="$OVL_D"  ;;
  esac
  [ -d "$DIR" ] || continue
  while IFS= read -r -d '' F; do
    NAME="$(basename "$F")"
    if [ -n "${SEEN[$NAME]:-}" ] &&
       [ "$(awk '/^# @required/ { print $NF; exit }' "${SEEN[$NAME]}" 2>/dev/null || true)" = "true" ]; then
      MASKED_REQ[$NAME]="${LAYER[$NAME]}"
    fi
    SEEN[$NAME]="$F"
    LAYER[$NAME]="$LYR"
  done < <(find "$DIR" -maxdepth 1 -mindepth 1 \( -type f -o -type l \) -name '*.sh' -print0 2>/dev/null)
done

# --- Sort by name (numeric prefix ordering: 05 < 10 < 20 < 90) -------------
if [ "${#SEEN[@]}" -gt 0 ]; then
  mapfile -t SORTED < <(printf '%s\n' "${!SEEN[@]}" | sort)
else
  SORTED=()
fi

# --- Execute ---------------------------------------------------------------
# A fragment that never returns used to freeze the window in total silence:
# `waitFor: postStartCommand` waits forever, nothing is printed, and the log
# stops mid-phase with no clue which fragment is at fault. Measured on a real
# boot — 70-orch-daemon.sh sat in wait4 on a daemon it had failed to orphan,
# and the only way to find it was `docker exec` + /proc/<pid>/wchan.
#
# This does NOT kill anything: a fragment may legitimately be slow (a 2-3 GB
# pull, a firewall bake). It only makes the wait visible and names the culprit.
# Set DEVC_HOOK_WARN_AFTER=0 to silence it.
_frag_watchdog() {
  local key="$1" every="${DEVC_HOOK_WARN_AFTER:-30}" n=0 nap=
  [ "$every" -gt 0 ] 2>/dev/null || return 0
  # The nap runs in the BACKGROUND and a TERM trap kills it. With `while sleep
  # "$every"` the sleep was this subshell's FOREGROUND child, and a
  # non-interactive bash defers a signal until its foreground command returns:
  # the `kill` in run_frag was therefore only acted upon when the nap expired
  # on its own, and `wait` sat there for it. Every phase cost one full
  # DEVC_HOOK_WARN_AFTER after its last fragment — measured 2026-10-05, 30.02s
  # for a phase holding a single `true`, and ~30s in each of the two gaps of a
  # real boot cycle. `wait` is interruptible by a trap; a foreground sleep is
  # not. That is the whole difference.
  trap '[ -n "$nap" ] && kill "$nap" 2>/dev/null; exit 0' TERM
  while :; do
    sleep "$every" & nap=$!
    # Killed from run_frag → wait returns >128 and the trap above has already
    # taken the sleep with it; expired normally → 0, and the warning is due.
    wait "$nap" || break
    n=$(( n + every ))
    echo "⚠ ${key} has not returned after ${n}s — this phase is blocked on it."
    echo "    From the host, while it hangs:"
    echo "      docker exec <container> sh -c 'p=\$(pgrep -f ${key##*/}|head -1); cat /proc/\$p/wchan; ps -o pid,stat,args --ppid \$p'"
  done
}

# --- how long each fragment took ------------------------------------------
# Measured 2026-10-05 on symptems: a boot cycle of 101 s, of which nothing was
# attributable — the phase logs carry one timestamp per PHASE and not one per
# fragment, so "make the boot faster" had no measurement to aim at. EPOCHREALTIME
# is bash 5 and this image ships bash 5.2; when it is missing (a `sh` re-exec,
# an older shell) every duration reads 0 and the recap stays silent rather than
# lying.
FRAG_MS=()
_record_time() {  # _record_time <key> <t0 from EPOCHREALTIME>
  local key="$1" t0="$2" t1="${EPOCHREALTIME:-}" ms
  [ -n "$t0" ] && [ -n "$t1" ] || return 0
  # EPOCHREALTIME uses the LOCALE's radix character: under LC_NUMERIC=fr_FR it
  # is a comma, the two halves below would not split, and every phase log would
  # carry an arithmetic error instead of a duration. No dot, no timing.
  case "$t0$t1" in *.*.*) ;; *) return 0 ;; esac
  # EPOCHREALTIME is "seconds.microseconds"; integer arithmetic on the two
  # halves keeps this free of bc, awk and the locale's decimal separator.
  ms=$(( (${t1%%.*} - ${t0%%.*}) * 1000 + (10#${t1##*.} - 10#${t0##*.}) / 1000 ))
  [ "$ms" -ge 0 ] 2>/dev/null || return 0
  FRAG_MS+=("$ms $key")
  # One line per slow fragment, where it happened. The threshold is the point
  # where a human notices; everything quicker is only in the recap.
  [ "$ms" -ge "${DEVC_HOOK_SLOW_MS:-1000}" ] \
    && printf '    … %s took %d.%01ds\n' "$key" "$((ms / 1000))" "$(((ms % 1000) / 100))"
  return 0
}

# The three that cost the most, on one line, just before the phase's last line.
_say_slowest() {
  [ "${#FRAG_MS[@]}" -gt 0 ] || return 0
  local total=0 e line=""
  for e in "${FRAG_MS[@]}"; do total=$(( total + ${e%% *} )); done
  while IFS=' ' read -r ms key; do
    [ -n "$key" ] || continue
    line="$line · $key $((ms / 1000)).$(((ms % 1000) / 100))s"
  # sed, not `head -3`: this script runs under `pipefail` and a writer still
  # writing when head exits takes SIGPIPE (141) — the trap init-firewall.sh
  # documents at length. sed reads to EOF.
  done < <(printf '%s\n' "${FRAG_MS[@]}" | sort -rn | sed -n '1,3p')
  printf '  fragments %d.%01ds total, slowest%s\n' \
    "$((total / 1000))" "$(((total % 1000) / 100))" "${line# ·}"
}

run_frag() {
  local name="$1" frag="$2"
  local key="${PHASE}.d/${name}"
  local lyr="${LAYER[$name]}"
  local req
  req=$(awk '/^# @required/ { print $NF; exit }' "$frag" 2>/dev/null || true)
  req="${req:-false}"
  if [ -n "${MASKED_REQ[$name]:-}" ]; then
    echo "⚠ ${key} comes from '${lyr}' and shadows a '${MASKED_REQ[$name]}' fragment marked @required true" >&2
  fi
  local mode
  mode=$(disabled_mode "$key")
  if [ -n "$mode" ]; then
    if [ "$req" = "true" ] && [ "$mode" != "force" ]; then
      # Nothing used to stop a project from switching off the firewall
      # bring-up and booting wide open without a word.
      echo "⚠ REFUSED to disable ${key} — it declares @required true, running it anyway." >&2
      echo "    To override deliberately, list it as \"!${key}\"." >&2
    else
      echo "  skip ${key} (disabled by config)"
      return 0
    fi
  fi
  if $DRY_RUN; then
    echo "→ WOULD RUN ${key} (${lyr}, required=${req})"
    return 0
  fi
  # Indented, so the log keeps one `run <key>` per fragment in order — the
  # phase's table of contents — and the terminal keeps none. This is what makes
  # a silent fragment produce NOTHING on screen without a flag per fragment.
  # It replaces the earlier "silence is success" reasoning, which kept this line
  # visible as live progress: the tools that actually take time (init-firewall,
  # ext-patches-sync) each print their own `→` step, and the log has all 26.
  echo "  run ${key} (${lyr}, required=${req})"
  local rc=0
  _frag_watchdog "$key" &
  local _wd=$!
  local _t0="${EPOCHREALTIME:-}"
  bash "$frag" || rc=$?
  _record_time "$key" "$_t0"
  kill "$_wd" 2>/dev/null || true
  wait "$_wd" 2>/dev/null || true
  if [ "$rc" -ne 0 ]; then
    if [ "$req" = "true" ]; then
      echo "✗ FAIL ${key} (rc=$rc) — required, aborting phase" >&2
      # Carried by the ✗ above. This is what makes "silent by default" honest:
      # a fragment that dies without a word is still named, with the command.
      echo "   ↳ what it printed: grep -n \"run ${key}\" -A 40 ${LOG#/workspace/}" >&2
      exit "$rc"
    else
      echo "⚠ WARN ${key} (rc=$rc) — optional, continuing" >&2
      echo "   ↳ what it printed: grep -n \"run ${key}\" -A 40 ${LOG#/workspace/}" >&2
    fi
  fi
}

for NAME in "${SORTED[@]}"; do
  run_frag "$NAME" "${SEEN[$NAME]}"
done

# --- Flat fallback (Debian run-parts pattern) ------------------------------
# If the overlay dir also has a flat <phase>.sh, run it LAST. Lets user
# projects mix .d/ fragments and a single script.
if [ -x "$FLAT" ]; then
  echo "  run flat overlay ${PHASE}.sh"
  if ! $DRY_RUN; then
    bash "$FLAT" || echo "⚠ WARN flat ${PHASE}.sh (rc=$?)" >&2
  fi
fi

_say_slowest
echo "=== $PHASE done ==="
